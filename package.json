{
  "name": "data-processor",
  "version": "1.0.0",
  "description": "Data processor that analyzes CSV files and generates statistics - JS translation of data_processor.py",
  "main": "data_processor.js",
  "type": "module",
  "scripts": {
    "start": "node data_processor.js",
    "server": "node server.js",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "test:watch": "node --experimental-vm-modules node_modules/.bin/jest --watch"
  },
  "jest": {
    "transform": {},
    "testEnvironment": "node",
    "testMatch": [
      "**/*.test.js"
    ]
  },
  "dependencies": {
    "csv-parse": "^5.0.0",
    "express": "^4.18.2",
    "multer": "^2.0.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "jest": "^30.5.2",
    "supertest": "^7.3.2"
  }
}
